# ============================================================
# TaxWatch — 環境設定範本
# 複製此檔為 .env 並填入實際值：cp .env.example .env
# ============================================================

# ── 資料庫 ───────────────────────────────────────────────────
# PostgreSQL 連線字串（psycopg3 格式）
# 範例：postgresql+psycopg://user:password@localhost:5432/mydb
DATABASE_URL=postgresql+psycopg://taxwatch:taxwatch_dev@localhost:5432/taxwatch

# PostgreSQL Schema 名稱（預設空白 = 使用 public）
# 設定後，init_db() 會自動執行 CREATE SCHEMA IF NOT EXISTS
# 範例：DB_SCHEMA=taxwatch
DB_SCHEMA=

# ── LLM（Deep Research 用）───────────────────────────────────
# 使用 Anthropic API：
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-opus-5
#
# 使用本地 Ollama：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ── Brave Search（異動佐證查詢，可選）────────────────────────
# 申請：https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENABLED=true
BRAVE_SEARCH_MAX_RESULTS=5

# ── Email 通知（可選）────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=taxwatch@example.com
EMAIL_TO=

# ── 本機路徑 ─────────────────────────────────────────────────
# 抓取的原始檔案存放目錄
DATA_DIR=./data
# 資料來源設定檔位置
SOURCES_PATH=config/sources.yaml
